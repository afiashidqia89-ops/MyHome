# ============================================================
# RumahLayak — contoh environment variables
# Salin menjadi .env (sandbox) atau isi di Vercel > Settings >
# Environment Variables (produksi). JANGAN commit .env asli.
# ============================================================

# ---------- Sandbox / pengembangan (SQLite demo) ----------
DATABASE_URL=file:./db/custom.db

# ---------- Produksi (Neon PostgreSQL, dipakai Vercel) ----------
# Ambil dari Neon Console > Project > Connection Details.
# Gunakan connection string LANGSUNG (tanpa "-pooler") agar
# `prisma db push` saat build berjalan mulus.
# DATABASE_URL="postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/rumahlayak?sslmode=require"

# ---------- Secret JWT (HS256, cookie httpOnly + Bearer) ----------
# Buat dengan: openssl rand -hex 32
AUTH_SECRET=ganti-dengan-secret-acak-panjang
